generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "sqlite"
 url      = "file:./dev.db"
}

model User {
 id        Int      @id @default(autoincrement())
 fullName  String
 birthDate DateTime
 email     String   @unique
 password  String
 role      String   @default("user")
 isActive  Boolean  @default(true)
 createdAt DateTime @default(now())
}